# Python environment and generated bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Local credentials; keep an example if one is added later
.env
.env.*
!.env.example

# Local game data and translation work (prefer directories outside this repo)
/games/
/work/
/output/
/translated/
.game-translation-build-*/
/packages/
/.local*/
/archive/

# Local collaboration instructions and private development material
/AGENTS.md
/.agents/
/.codex/
/agent_console_clean.txt
/desktop/local/
/desktop/design/
/desktop/学习记录.md
/desktop/学习记录.txt
/desktop/PLAN.md
/desktop/docs/*
!/desktop/docs/EXTENSION_API.md
/DesktopHarness.exe

# Private runtime databases and credential exports (not source modules)
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db
*.db-wal
*.db-shm
*.pem
*.p12
*.pfx

# Local build logs; release source and build scripts remain public
/desktop-release/*.log

# Local tool and OS caches
.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini

# Local real-game validation data
/test/
/tests/

# Optional locally built Mono helper and downloaded dependencies
/tools/unity_mono/bin/
/tools/unity_mono/deps/

# Optional Addressables helper builds and dependencies
/tools/unity_addressables/bin/
/tools/unity_addressables/obj/
/tools/unity_addressables/deps/

# Optional WOLF tools, downloaded separately
/tools/wolf/bin/

# Optional Ren'Py tool checkouts, downloaded separately
/tools/renpy/vendor/

# Optional GDRETools distribution, downloaded separately
/tools/godot/bin/
